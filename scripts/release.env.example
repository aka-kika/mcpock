# Copy to scripts/release.env (git-ignored) and fill in your own values.

# SHA-1 hash of your "Developer ID Application" identity:
#   security find-identity -v -p codesigning
MCPOCK_SIGN_IDENTITY=""

# The keychain profile you created with `xcrun notarytool store-credentials`.
MCPOCK_NOTARY_PROFILE=""

# Sparkle signing key account in your login Keychain (generate_keys --account <name>).
SPARKLE_KEY_ACCOUNT="mcpock"
